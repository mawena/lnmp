#!/bin/bash

# ==============================================================================
# Script de Gestion Avancée LNMP & Certbot
# Version : 1.4 - Support des commandes directes CLI & Commande reload-app
# ==============================================================================

# Version injectée au build par debian/rules (placeholder @VERSION@).
# Fallback si le script est exécuté depuis les sources non compilées.
VERSION="@VERSION@"
if [[ "$VERSION" == "@VERSION@" ]]; then
    VERSION="$(dpkg-query -W -f='${Version}' lnmp 2>/dev/null || echo 'dev')"
fi

# Version de PHP utilisée par la pile (centralisée pour faciliter les montées de version).
PHP_VERSION="8.3"

STATE_FILE="/var/log/lnmp_install_state"
APPS_REGISTRY="/etc/nginx/lnmp_apps.list"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}Erreur : Ce script doit être exécuté en tant que root (sudo).${NC}"
    exit 1
fi

REAL_USER=${SUDO_USER:-$(logname 2>/dev/null || echo $USER)}
if [ "$REAL_USER" = "root" ]; then
    REAL_USER=$(awk -F: '$3>=1000 && $1!="nobody" {print $1; exit}' /etc/passwd)
fi

touch "$APPS_REGISTRY"

get_state() {
    if [ -f "$STATE_FILE" ]; then
        local val=$(cat "$STATE_FILE" | tr -d '[:space:]')
        [[ "$val" =~ ^[0-7]$ ]] && echo "$val" || echo "0"
    else
        echo "0"
    fi
}

set_state() {
    echo "$1" > "$STATE_FILE"
}

# ==============================================================================
# HELPERS : VALIDATION & RECHARGEMENT SÛR DE NGINX
# ==============================================================================

# Valide un identifiant d'application (empêche l'injection dans les vhosts).
validate_app_id() {
    [[ "$1" =~ ^[a-zA-Z0-9._-]+$ ]]
}

# Valide un nom de domaine.
validate_domain() {
    [[ "$1" =~ ^[a-zA-Z0-9.-]+$ ]]
}

# Teste la configuration Nginx puis recharge sans coupure. Ne recharge JAMAIS
# une configuration invalide (contrairement à un restart aveugle).
reload_nginx() {
    if nginx -t 2>/dev/null; then
        systemctl reload nginx
        return 0
    fi
    echo -e "${RED}Erreur : configuration Nginx invalide. Rechargement annulé.${NC}"
    nginx -t
    return 1
}

# ==============================================================================
# FONCTIONS D'AIDE ET VERSIONS
# ==============================================================================
show_help() {
    echo -e "${BLUE}Usage : lnmp [COMMANDE / OPTION] [ARGUMENTS]${NC}"
    echo ""
    echo "Options Générales :"
    echo "  -h, --help            Afficher cette aide"
    echo "  -v, --version         Afficher la version de l'outil"
    echo ""
    echo "Commandes Globales :"
    echo "  install               Lancer ou reprendre l'installation de la pile"
    echo "  uninstall             Désinstaller complètement la pile et ses composants"
    echo "  doctor                Diagnostiquer l'état de la pile (services, SSL, vhosts)"
    echo ""
    echo "Commandes de Gestion des Applications (CLI Direct) :"
    echo "  list                  Lister les applications web du registre"
    echo "  add                   Ajouter une nouvelle application web"
    echo "  delete [id]           Supprimer définitivement une application web"
    echo "  enable [id]           Activer une application (Link vhost)"
    echo "  disable [id]          Désactiver une application (Unlink vhost)"
    echo "  add-ssl [id]          Ajouter un certificat SSL Let's Encrypt"
    echo "  remove-ssl [id]       Retirer un certificat SSL"
    echo "  reload-app            Reconstruire le registre à partir des configurations Nginx réelles"
    echo ""
    echo "Commandes de Gestion des Bases de Données (MariaDB) :"
    echo "  db-create [nom]       Créer une base et un utilisateur dédié"
    echo "  db-list               Lister les bases de données"
    echo "  db-drop [nom]         Supprimer une base de données"
    echo ""
    echo "Note : Si aucune commande n'est fournie, le menu interactif s'ouvrira."
}

show_version() {
    echo -e "${GREEN}LNMP CLI Manager - Version $VERSION${NC}"
}

# ==============================================================================
# NOUVELLE COMMANDE : RELOAD-APP (Reconstruction du Registre)
# ==============================================================================
reload_app() {
    echo -e "${BLUE}=== Reconstruction du registre LNMP depuis Nginx ===${NC}"
    local tmp_registry="/tmp/lnmp_apps.tmp"
    rm -f "$tmp_registry"
    touch "$tmp_registry"

    if [ ! -d /etc/nginx/sites-available ]; then
        echo -e "${RED}Erreur : Nginx ne semble pas installé ou configuré.${NC}"
        return
    fi

    for vhost_file in /etc/nginx/sites-available/*; do
        [ -e "$vhost_file" ] || continue
        local app_id=$(basename "$vhost_file")
        
        # Ignorer le fichier par défaut d'Ubuntu s'il existe encore
        if [ "$app_id" = "default" ]; then continue; fi

        # Extraction intelligente du server_name et du root depuis le fichier vhost
        local domain=$(grep -E '^[[:space:]]*server_name' "$vhost_file" | head -n 1 | awk '{print $2}' | tr -d ';')
        local root_path=$(grep -E '^[[:space:]]*root' "$vhost_file" | head -n 1 | awk '{print $2}' | tr -d ';')

        # Fallbacks si non trouvés
        [ -z "$domain" ] && domain="inconnu"
        [ -z "$root_path" ] && root_path="/var/www/html"

        echo "$app_id:$domain:$root_path" >> "$tmp_registry"
    done

    mv "$tmp_registry" "$APPS_REGISTRY"
    chmod 644 "$APPS_REGISTRY"
    echo -e "${GREEN}Registre réaligné avec succès ! ($(wc -l < "$APPS_REGISTRY") applications indexées)${NC}"
}

# ==============================================================================
# FONCTIONS D'INSTALLATION
# ==============================================================================
install_lnmp() {
    local current_step=$(get_state)
    echo -e "${BLUE}=== Début de l'installation de la pile LNMP ===${NC}"

    if [ "$current_step" -le 1 ]; then
        echo -e "${YELLOW}[1/7] Configuration système et 'acl'...${NC}"
        apt-get update -y && apt-get upgrade -y
        apt-get install -y acl software-properties-common curl wget unzip git
        set_state 1
    fi

    if [ "$current_step" -le 2 ]; then
        echo -e "${YELLOW}[2/7] Installation de Nginx...${NC}"
        apt-get install -y nginx
        systemctl enable --now nginx
        set_state 2
    fi

    if [ "$current_step" -le 3 ]; then
        echo -e "${YELLOW}[3/7] Installation de MariaDB...${NC}"
        apt-get install -y mariadb-server mariadb-client
        systemctl enable --now mariadb
        set_state 3
    fi

    if [ "$current_step" -le 4 ]; then
        echo -e "${YELLOW}[4/7] Installation PHP ${PHP_VERSION}...${NC}"
        add-apt-repository ppa:ondrej/php -y
        apt-get update -y
        apt-get install -y \
        php${PHP_VERSION}-fpm php${PHP_VERSION}-cli php${PHP_VERSION}-mysql \
        php${PHP_VERSION}-curl php${PHP_VERSION}-xml php${PHP_VERSION}-mbstring \
        php${PHP_VERSION}-zip php${PHP_VERSION}-bcmath php${PHP_VERSION}-soap \
        php${PHP_VERSION}-intl php${PHP_VERSION}-readline php${PHP_VERSION}-sqlite3 \
        php${PHP_VERSION}-gd php${PHP_VERSION}-redis
        systemctl enable --now php${PHP_VERSION}-fpm
        set_state 4
    fi

    if [ "$current_step" -le 5 ]; then
        echo -e "${YELLOW}[5/7] Installation de Certbot...${NC}"
        apt-get install -y certbot python3-certbot-nginx
        set_state 5
    fi

    if [ "$current_step" -le 6 ]; then
        echo -e "${YELLOW}[6/7] Droits et groupe webdev...${NC}"
        if ! getent group webdev > /dev/null; then groupadd webdev; fi
        if [ ! -z "$REAL_USER" ] && [ "$REAL_USER" != "root" ]; then
            usermod -aG webdev "$REAL_USER"
        fi
        usermod -aG webdev www-data
        mkdir -p /var/www/html
        chown -R www-data:webdev /var/www/html
        find /var/www/html -type d -exec chmod g+s {} \;
        chmod -R 775 /var/www/html
        setfacl -R -d -m g:webdev:rwx /var/www/html
        setfacl -R -d -m u:www-data:rwx /var/www/html
        set_state 6
    fi

    if [ "$current_step" -le 7 ]; then
        echo -e "${YELLOW}[7/7] Configuration du fichier témoin 'example'...${NC}"
        local initial_app_path="/var/www/html/Mawena/Flixger/public"
        mkdir -p "$initial_app_path"
        
        if [ ! -f "$initial_app_path/index.php" ]; then
            echo "<?php echo 'Bienvenue !'; ?>" > "$initial_app_path/index.php"
        fi

        cat > /etc/nginx/sites-available/example << EOF
server {
    listen 80;
    server_name .mawena.cloud;
    root /var/www/html/Mawena/Flixger/public;
    index index.php index.html;
    charset utf-8;
    location / { try_files \$uri \$uri/ /index.php?\$query_string; }
    location ~ \.php\$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php${PHP_VERSION}-fpm.sock;
    }
}
EOF
        [ -f /etc/nginx/sites-enabled/default ] && rm /etc/nginx/sites-enabled/default
        reload_nginx
        set_state 7
    fi

    echo -e "${GREEN}=== LNMP Installée ! ===${NC}"
}

uninstall_lnmp() {
    read -p "Voulez-vous vraiment TOUT supprimer ? (y/n) : " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        systemctl stop nginx mariadb php8.3-fpm || true
        apt-get purge -y nginx mariadb-server mariadb-client "php${PHP_VERSION}*" certbot python3-certbot-nginx acl
        apt-get autoremove -y
        rm -f "$STATE_FILE" "$APPS_REGISTRY"
        rm -rf /etc/nginx
        echo -e "${GREEN}Désinstallation complète réussie.${NC}"
        exit 0
    fi
}

# ==============================================================================
# GESTION DES APPLICATIONS (UNIFIÉE CLI & MENU)
# ==============================================================================
add_web_app() {
    echo -e "${BLUE}=== Ajouter une nouvelle application Web ===${NC}"
    read -p "ID unique de l'app (ex: api-prod) : " app_id
    app_id=$(echo "$app_id" | tr -d ' ')

    if [ -z "$app_id" ]; then return; fi
    if ! validate_app_id "$app_id"; then
        echo -e "${RED}Erreur : ID invalide. Caractères autorisés : lettres, chiffres, . _ -${NC}"
        return
    fi
    if [ -f "/etc/nginx/sites-available/$app_id" ]; then
        echo -e "${RED}Erreur : Cet ID existe déjà.${NC}"
        return
    fi

    read -p "Nom de domaine complet (ex: app.mawena.cloud) : " domain_name
    if ! validate_domain "$domain_name"; then
        echo -e "${RED}Erreur : Nom de domaine invalide.${NC}"
        return
    fi
    read -p "Chemin absolu (ex: /var/www/html/Projet/public) : " app_path
    if [[ "$app_path" != /* ]]; then
        echo -e "${RED}Erreur : le chemin doit être absolu (commencer par /).${NC}"
        return
    fi

    mkdir -p "$app_path"
    chown -R www-data:webdev "$app_path"

    cat > /etc/nginx/sites-available/"$app_id" << EOF
server {
    listen 80;
    server_name $domain_name;
    root $app_path;
    index index.html index.php;
    charset utf-8;
    location / { try_files \$uri \$uri/ /index.php?\$query_string; }
    location ~ \.php\$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php${PHP_VERSION}-fpm.sock;
    }
}
EOF

    ln -sf /etc/nginx/sites-available/"$app_id" /etc/nginx/sites-enabled/
    if ! reload_nginx; then
        echo -e "${RED}Annulation : suppression du vhost défectueux.${NC}"
        rm -f /etc/nginx/sites-enabled/"$app_id" /etc/nginx/sites-available/"$app_id"
        return
    fi

    echo "$app_id:$domain_name:$app_path" >> "$APPS_REGISTRY"
    echo -e "${GREEN}Application '$app_id' ajoutée et activée.${NC}"

    read -p "Générer un certificat SSL Let's Encrypt ? (y/n) : " gen_ssl
    if [[ "$gen_ssl" =~ ^[Yy]$ ]]; then add_ssl_cert "$app_id"; fi
}

list_web_apps() {
    if [ ! -s "$APPS_REGISTRY" ]; then echo "Aucune application enregistrée."; return; fi
    
    echo -e "ID App\t\t| Statut\t| Domaine"
    echo "------------------------------------------------------------------------"
    while IFS=: read -r id domain path; do
        if [ -f "/etc/nginx/sites-enabled/$id" ]; then
            status="${GREEN}Actif${NC}"
        else
            status="${RED}Inactif${NC}"
        fi
        echo -e "${GREEN}$id${NC}\t| $status\t| $domain"
    done < "$APPS_REGISTRY"
}

enable_web_app() {
    local target_id=$1
    if [ -z "$target_id" ]; then
        echo "Applications disponibles dans sites-available :"
        ls -1 /etc/nginx/sites-available/
        echo "--------------------------------------------------"
        read -p "Entrez l'ID de l'application à activer : " target_id
    fi
    [ -z "$target_id" ] && return

    if [ ! -f "/etc/nginx/sites-available/$target_id" ]; then
        echo -e "${RED}Erreur : Le fichier vhost n'existe pas dans sites-available.${NC}"
        return
    fi
    if [ -f "/etc/nginx/sites-enabled/$target_id" ]; then
        echo -e "${YELLOW}L'application est déjà active.${NC}"
        return
    fi
    ln -sf /etc/nginx/sites-available/"$target_id" /etc/nginx/sites-enabled/
    if ! reload_nginx; then
        rm -f /etc/nginx/sites-enabled/"$target_id"
        return
    fi
    echo -e "${GREEN}Application '$target_id' mise en ligne avec succès !${NC}"
}

disable_web_app() {
    local target_id=$1
    if [ -z "$target_id" ]; then
        echo -e "Applications enregistrées :"
        list_web_apps
        echo "--------------------------------------------------"
        read -p "Entrez l'ID de l'application à désactiver : " target_id
    fi
    [ -z "$target_id" ] && return

    if [ ! -f "/etc/nginx/sites-enabled/$target_id" ]; then
        echo -e "${YELLOW}L'application '$target_id' est déjà inactive ou non liée.${NC}"
        return
    fi
    rm -f /etc/nginx/sites-enabled/"$target_id"
    reload_nginx
    echo -e "${GREEN}Application '$target_id' désactivée (hors ligne).${NC}"
}

delete_web_app() {
    local target_id=$1
    if [ -z "$target_id" ]; then
        echo -e "Applications enregistrées :"
        list_web_apps
        echo "--------------------------------------------------"
        read -p "Entrez l'ID de l'application à supprimer : " target_id
    fi
    [ -z "$target_id" ] && return

    rm -f /etc/nginx/sites-enabled/"$target_id"
    rm -f /etc/nginx/sites-available/"$target_id"
    sed -i "/^$target_id:/d" "$APPS_REGISTRY"
    reload_nginx
    echo -e "${GREEN}Application '$target_id' supprimée définitivement.${NC}"
}

add_ssl_cert() {
    local target_id=$1
    if [ -z "$target_id" ]; then
        read -p "ID de l'application à sécuriser : " target_id
    fi
    [ -z "$target_id" ] && return

    local domain=$(grep "^$target_id:" "$APPS_REGISTRY" | cut -d: -f2)
    if [ -z "$domain" ]; then echo -e "${RED}ID Inconnu.${NC}"; return; fi

    read -p "Email pour les alertes d'expiration (laisser vide pour ignorer) : " le_email
    if [ -n "$le_email" ]; then
        certbot --nginx -d "$domain" --redirect --agree-tos --non-interactive -m "$le_email"
    else
        certbot --nginx -d "$domain" --redirect --agree-tos --non-interactive --register-unsafely-without-email
    fi
}

remove_ssl_cert() {
    local target_id=$1
    if [ -z "$target_id" ]; then
        read -p "ID de l'application : " target_id
    fi
    [ -z "$target_id" ] && return

    local domain=$(grep "^$target_id:" "$APPS_REGISTRY" | cut -d: -f2)
    if [ -z "$domain" ]; then echo -e "${RED}ID Inconnu.${NC}"; return; fi
    certbot delete --cert-name "$domain"
    reload_nginx
}

# ==============================================================================
# DIAGNOSTIC DE LA PILE
# ==============================================================================
doctor() {
    echo -e "${BLUE}=== Diagnostic de la pile LNMP ===${NC}"

    echo -e "\n${YELLOW}Services :${NC}"
    for svc in nginx mariadb "php${PHP_VERSION}-fpm"; do
        if systemctl is-active --quiet "$svc"; then
            echo -e "  ${GREEN}●${NC} $svc : actif"
        else
            echo -e "  ${RED}○${NC} $svc : inactif ou absent"
        fi
    done

    echo -e "\n${YELLOW}Configuration Nginx :${NC}"
    if nginx -t 2>/dev/null; then
        echo -e "  ${GREEN}●${NC} Syntaxe valide"
    else
        echo -e "  ${RED}○${NC} Syntaxe invalide (voir 'nginx -t')"
    fi

    echo -e "\n${YELLOW}Applications enregistrées :${NC}"
    if [ -s "$APPS_REGISTRY" ]; then
        list_web_apps
    else
        echo "  Aucune."
    fi

    echo -e "\n${YELLOW}Certificats SSL :${NC}"
    if command -v certbot >/dev/null 2>&1; then
        certbot certificates 2>/dev/null | grep -E "Certificate Name|Expiry Date" | sed 's/^/  /' || echo "  Aucun certificat."
    else
        echo "  Certbot non installé."
    fi
}

# ==============================================================================
# GESTION DES BASES DE DONNÉES (MariaDB)
# ==============================================================================
db_create() {
    local db_name=$1
    if [ -z "$db_name" ]; then
        read -p "Nom de la base à créer : " db_name
    fi
    [ -z "$db_name" ] && return
    if ! validate_app_id "$db_name"; then
        echo -e "${RED}Erreur : nom de base invalide (lettres, chiffres, . _ -).${NC}"
        return
    fi

    local db_user="${db_name}_user"
    local db_pass
    db_pass=$(openssl rand -base64 18 2>/dev/null | tr -d '/+=' | cut -c1-20)
    [ -z "$db_pass" ] && db_pass=$(head -c 15 /dev/urandom | base64 | tr -d '/+=' | cut -c1-20)

    if ! mariadb -e "CREATE DATABASE IF NOT EXISTS \`$db_name\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"; then
        echo -e "${RED}Erreur : impossible de créer la base (MariaDB accessible en root ?).${NC}"
        return
    fi
    mariadb -e "CREATE USER IF NOT EXISTS '$db_user'@'localhost' IDENTIFIED BY '$db_pass';"
    mariadb -e "GRANT ALL PRIVILEGES ON \`$db_name\`.* TO '$db_user'@'localhost';"
    mariadb -e "FLUSH PRIVILEGES;"

    echo -e "${GREEN}Base de données créée.${NC}"
    echo -e "  Base        : ${BLUE}$db_name${NC}"
    echo -e "  Utilisateur : ${BLUE}$db_user${NC}"
    echo -e "  Mot de passe: ${YELLOW}$db_pass${NC}"
    echo -e "${RED}Notez ce mot de passe : il ne sera plus affiché.${NC}"
}

db_list() {
    echo -e "${BLUE}=== Bases de données ===${NC}"
    mariadb -e "SHOW DATABASES;" 2>/dev/null | grep -vE '^(Database|information_schema|performance_schema|mysql|sys)$' \
        || echo -e "${RED}MariaDB inaccessible.${NC}"
}

db_drop() {
    local db_name=$1
    if [ -z "$db_name" ]; then
        db_list
        read -p "Nom de la base à supprimer : " db_name
    fi
    [ -z "$db_name" ] && return
    if ! validate_app_id "$db_name"; then
        echo -e "${RED}Erreur : nom de base invalide.${NC}"
        return
    fi
    read -p "Supprimer DÉFINITIVEMENT la base '$db_name' et son utilisateur ? (y/n) : " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || return
    mariadb -e "DROP DATABASE IF EXISTS \`$db_name\`;"
    mariadb -e "DROP USER IF EXISTS '${db_name}_user'@'localhost';"
    mariadb -e "FLUSH PRIVILEGES;"
    echo -e "${GREEN}Base '$db_name' supprimée.${NC}"
}

# ==============================================================================
# ROUTAGE INTELLIGENT DES COMMANDES CLI DIRECTES
# ==============================================================================
if [ $# -gt 0 ]; then
    case "$1" in
        -h|--help|help)           show_help; exit 0 ;;
        -v|--version|version)     show_version; exit 0 ;;
        install)                  install_lnmp; exit 0 ;;
        uninstall)                uninstall_lnmp; exit 0 ;;
        doctor)                   doctor; exit 0 ;;
        list)                     list_web_apps; exit 0 ;;
        add)                      add_web_app; exit 0 ;;
        reload-app)               reload_app; exit 0 ;;
        enable)                   enable_web_app "$2"; exit 0 ;;
        disable)                  disable_web_app "$2"; exit 0 ;;
        delete)                   delete_web_app "$2"; exit 0 ;;
        add-ssl)                  add_ssl_cert "$2"; exit 0 ;;
        remove-ssl)               remove_ssl_cert "$2"; exit 0 ;;
        db-create)                db_create "$2"; exit 0 ;;
        db-list)                  db_list; exit 0 ;;
        db-drop)                  db_drop "$2"; exit 0 ;;
        *)                        echo -e "${RED}Commande inconnue : $1${NC}"; show_help; exit 1 ;;
    esac
fi

# ==============================================================================
# BOUCLE DU MENU INTERACTIF (SI AUCUN ARGUMENT)
# ==============================================================================
while true; do
    clear
    echo -e "${BLUE}=====================================================${NC}"
    echo -e "${GREEN}             GESTIONNAIRE LNMP AUTOMATIQUE            ${NC}"
    echo -e "${BLUE}=====================================================${NC}"
    echo " 1 - Installer / Reprendre l'installation LNMP"
    echo " 2 - Lister les applications web"
    echo " 3 - Ajouter une application web"
    echo " 4 - Supprimer des applications web"
    echo " 5 - Ajouter un certificat SSL à une application"
    echo " 6 - Retirer un certificat SSL à une application"
    echo " 7 - Désinstaller complètement LNMP"
    echo " 8 - Activer une application (Link vhost)"
    echo " 9 - Désactiver une application (Unlink vhost)"
    echo "10 - Créer une base de données"
    echo "11 - Lister les bases de données"
    echo "12 - Supprimer une base de données"
    echo " D - Diagnostic de la pile (doctor)"
    echo " R - Reconstruire le registre (Reload-app)"
    echo " 0 - Quitter"
    echo -e "${BLUE}=====================================================${NC}"
    read -p "Choisissez une option : " choice

    case $choice in
        1) install_lnmp ;;
        2) echo -e "${BLUE}=== Registre ===${NC}"; list_web_apps ;;
        3) add_web_app ;;
        4) delete_web_app ;;
        5) add_ssl_cert ;;
        6) remove_ssl_cert ;;
        7) uninstall_lnmp ;;
        8) enable_web_app ;;
        9) disable_web_app ;;
        10) db_create ;;
        11) db_list ;;
        12) db_drop ;;
        [Dd]) doctor ;;
        [Rr]) reload_app ;;
        0) exit 0 ;;
        *) echo -e "${RED}Option invalide.${NC}" ;;
    esac
    echo -e "\nAppuyez sur [ENTRÉE] pour continuer..."
    read
done